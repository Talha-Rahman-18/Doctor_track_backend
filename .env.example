# ---------- Server ----------
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# ---------- Database ----------
# Example only. Replace with your own MongoDB Atlas or local connection string.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/doctor_tracker?retryWrites=true&w=majority

# ---------- Authentication (JWT) ----------
# You control these values. Use a long random string (>= 32 chars) for the secret.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
# Format: <number><s|m|h|d>   e.g. 30m, 12h, 7d
JWT_EXPIRES_IN=1d
COOKIE_NAME=dt_token
# Must be true in production (requires HTTPS). false is fine for http://localhost.
COOKIE_SECURE=false
# lax | strict | none   ("none" requires COOKIE_SECURE=true)
COOKIE_SAME_SITE=lax
BCRYPT_ROUNDS=12

# ---------- CORS / proxy ----------
# Comma-separated list of allowed browser origins.
CLIENT_URL=http://localhost:3000
# Number of reverse-proxy hops to trust for X-Forwarded-For (0 = none).
TRUST_PROXY=0

# ---------- Rate limiting (per IP, per process) ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_ANALYTICS_MAX=60

# ---------- Seed admin (used only by `npm run seed:admin`) ----------
ADMIN_NAME=Demo Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe-Before-Use-123!
